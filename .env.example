PORT=PORT-HERE

ASANA_PAT=YOUR-ASANA_PAT-HERE
ASANA_GID=YOUR-ASANA_GID-HERE

# Required for FRT (first response time) calculation
DEDICATED_SUPPORT_GID=YOUR-SUPPORT-TEAM-GID-HERE

# Required for the urgent-keyword webhook
PRIORITY_CUSTOM_FIELD_GID=YOUR-PRIORITY-CUSTOM-FIELD-GID-HERE
URGENT_ENUM_PRIORITY_GID=YOUR-URGENT-ENUM-OPTION-GID-HERE
# Optional: delay (ms) before re-checking/re-applying Urgent priority, in case
# another Asana Rule reset it after we set it. Defaults to 90000 (90s).
URGENT_PRIORITY_RECHECK_DELAY_MS=90000
